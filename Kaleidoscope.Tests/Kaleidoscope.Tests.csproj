<Project Sdk="Microsoft.NET.Sdk">
  <!--
    We compile only the Dalamud-free Models/Resources source files directly instead of
    using a ProjectReference to the main project, because the main project targets
    net10.0-windows (Dalamud.NET.Sdk) which is incompatible with the plain net10.0
    target we need for cross-platform CI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kaleidoscope.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.0" />
  </ItemGroup>

  <!-- Compile only the Dalamud-free resource model types from the main project -->
  <ItemGroup>
    <Compile Include="..\Kaleidoscope\Models\Resources\*.cs" />
    <Compile Include="..\Kaleidoscope\Models\TrackedDataType.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\ResourceCatalog.cs" />
    <Compile Include="..\Kaleidoscope\Services\AutoRetainerFcPointsSyncPolicy.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\ResourceStore.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\ResourceDbWriter.cs" />
    <Compile Include="..\Kaleidoscope\Services\Database\MigrationSql.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\SourceTagSink.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\ResourceObservationService.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\LoadedContainerSet.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\Adapters\LegacyVariableTranslator.cs" />
    <Compile Include="..\Kaleidoscope\Services\Resources\Adapters\ResourceToLegacyAdapter.cs" />
    <Compile Include="..\Kaleidoscope\Models\Inventory\InventoryCacheEntry.cs" />
    <Compile Include="..\Kaleidoscope\Models\Inventory\InventoryItemSnapshot.cs" />
    <Compile Include="..\Kaleidoscope\Services\Common\RotatingFileWriter.cs" />
    <Compile Include="..\Kaleidoscope\Services\Profiler\ProfilerSnapshot.cs" />
    <Compile Include="..\Kaleidoscope\Services\Profiler\ProfilerCsvFormatter.cs" />
    <Compile Include="..\Kaleidoscope\Services\Universalis\SaleOutlierFilter.cs" />
    <Compile Include="..\Kaleidoscope\Models\Universalis\ListingsCacheEntry.cs" />
    <Compile Include="..\Kaleidoscope\Models\Universalis\RecentSalesCache.cs" />
    <Compile Include="..\Kaleidoscope\Models\Universalis\PriceTrackingSettings.cs" />
  </ItemGroup>
</Project>
